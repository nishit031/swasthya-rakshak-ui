# Docker Compose (pins volume/container names regardless of folder path)
COMPOSE_PROJECT_NAME=swasthya_rakshak

# App
NEXT_PUBLIC_APP_NAME=Swasthya Rakshak
NEXT_PUBLIC_FRONTEND_API_URL=http://localhost:3000

# Backend API origin — the separate Laravel service (see backend/). The frontend calls this for
# every /api/v1 request and loads uploaded files from it. Leave empty for a same-origin setup.
# Must be NEXT_PUBLIC_-prefixed — read client-side by src/backend/lib/api-url.ts.
NEXT_PUBLIC_NEXT_PUBLIC_BACKEND_API_URL=http://127.0.0.1:5000

# Optional
NODE_ENV=development